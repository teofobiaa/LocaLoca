<Application
    x:Class="LocaLoca.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Make text inputs readable in every visual state. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FBFCF8" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F0F2EE" />

                    <SolidColorBrush x:Key="TextControlForeground" Color="#172521" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#172521" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#172521" />
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#87938B" />

                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#78877F" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#66766D" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#66766D" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#A4AEA7" />

                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D5DED6" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A8BB9C" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#86A958" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#E3E8E2" />
                    <Color x:Key="TextControlSelectionHighlightColor">#BFE879</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Цвет подсказок для полей ввода -->
            <SolidColorBrush
            x:Key="TextControlPlaceholderForeground"
            Color="#78877F" />

            <!-- Обычные поля -->
            <Style TargetType="TextBox"
               BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#172521" />
                <Setter Property="BorderBrush" Value="#D5DED6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Поля пароля -->
            <Style TargetType="PasswordBox"
               BasedOn="{StaticResource DefaultPasswordBoxStyle}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#172521" />
                <Setter Property="BorderBrush" Value="#D5DED6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Brand palette -->
            <SolidColorBrush x:Key="CanvasBrush" Color="#F4F5F1" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InkBrush" Color="#172521" />
            <SolidColorBrush x:Key="MutedBrush" Color="#68776E" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#182E2A" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#29443D" />
            <SolidColorBrush x:Key="AccentBrush" Color="#C9F27A" />
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#8EBB48" />
            <SolidColorBrush x:Key="CoralBrush" Color="#F2B4A5" />
            <SolidColorBrush x:Key="LineBrush" Color="#E1E7DF" />

            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#172521" />
                <Setter Property="PlaceholderForeground" Value="#78877F" />
                <Setter Property="BorderBrush" Value="#D5DED6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style TargetType="DatePicker" BasedOn="{StaticResource DefaultDatePickerStyle}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#172521" />
                <Setter Property="BorderBrush" Value="#D5DED6" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="#C9F27A" />
                <Setter Property="Foreground" Value="#172521" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,9" />
            </Style>

            <Style x:Key="DialogCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="#EEF1EB" />
                <Setter Property="Foreground" Value="#263A33" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,9" />
            </Style>

            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="Background" Value="#FBFCF9" />
                <Setter Property="Foreground" Value="#172521" />
                <Setter Property="MaxWidth" Value="560" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource DialogPrimaryButtonStyle}" />
                <Setter Property="CloseButtonStyle" Value="{StaticResource DialogCloseButtonStyle}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

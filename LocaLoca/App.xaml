                <Setter Property="Background" Value="{ThemeResource InputSurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource InputForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
                <Setter Property="Background" Value="{ThemeResource InputSurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource InputForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="FontSize" Value="14" />
            </Style>

